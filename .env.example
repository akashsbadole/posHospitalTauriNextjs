# MediCore HMS Environment Configuration
# Copy this to .env and fill in your values

# Neon PostgreSQL Connection String
# Get this from your Neon dashboard: https://console.neon.tech
# Format: postgresql://username:password@host.neon.tech/medicore?sslmode=require
NEON_DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/medicore?sslmode=require"

# Application Settings
APP_ENV="production"
APP_DEBUG="false"
APP_LOG_LEVEL="info"

# API Configuration
API_BASE_URL="https://api.medicore.com"

# Email/SMS Configuration
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USERNAME="user@example.com"
SMTP_PASSWORD="password"

# Monitoring
SENTRY_DSN="your-sentry-dsn"
LOGDNA_KEY="your-logdna-key"

# Backup Configuration
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# Security
SECRET_KEY="your-secret-key-here"
ENCRYPTION_KEY="your-encryption-key-here"