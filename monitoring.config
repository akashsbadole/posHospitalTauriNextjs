# Monitoring Configuration
# This file configures monitoring, alerting, and observability for production deployment

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3

# Application Metrics
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics

# Error Tracking
SENTRY_ENABLED=true
SENTRY_ENVIRONMENT=production
SENTRY_SAMPLE_RATE=1.0

# Log Aggregation
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=/var/log/medicore/app.log
LOG_MAX_SIZE=100MB
LOG_MAX_FILES=5

# Performance Monitoring
PERFORMANCE_MONITORING_ENABLED=true
PERFORMANCE_SAMPLE_RATE=0.1

# Alerting
ALERT_EMAIL_ENABLED=true
ALERT_EMAIL_RECIPIENTS=admin@hospital.com,devops@hospital.com
ALERT_SLACK_ENABLED=true
ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Database Monitoring
DB_CONNECTION_POOL_SIZE=10
DB_CONNECTION_TIMEOUT=30s
DB_QUERY_TIMEOUT=60s

# Cache Configuration
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600s

# Security Monitoring
SECURITY_AUDIT_LOG_ENABLED=true
FAILED_LOGIN_ATTEMPTS_THRESHOLD=5
SESSION_TIMEOUT=30m

# Backup Monitoring
BACKUP_SUCCESS_THRESHOLD=24h  # Alert if no successful backup in 24 hours
BACKUP_SIZE_THRESHOLD=100MB   # Alert if backup size is suspiciously small